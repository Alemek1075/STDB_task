// University Management System — database schema
// Open https://dbdiagram.io/d and paste this file to get the visual diagram.
// Naming standard: English, snake_case, plural table names, surrogate key "id",
// foreign keys "<entity>_id", check-style enums stored as varchar.

Project university {
  database_type: 'PostgreSQL'
  Note: 'Variant 1 — Система управління університетом'
}

// ───────────────────────── Audit & soft delete (reusable column sets) ─────────────────────────
// created_by / updated_by / deleted_by are FKs to app_users.id in the physical model.
// They are filled by triggers from the session variable app.user_id (see docs/requirements.md).

TablePartial audit_fields {
  created_at  timestamptz  [not null, default: `now()`]
  created_by  int          [note: 'FK app_users.id']
  updated_at  timestamptz  [not null, default: `now()`]
  updated_by  int          [note: 'FK app_users.id']
}

TablePartial soft_delete {
  deleted_at  timestamptz  [note: 'NULL = active row']
  deleted_by  int          [note: 'FK app_users.id']
}

// ───────────────────────── Security & history ─────────────────────────

Table app_users {
  id           int          [pk, increment]
  username     varchar(50)  [not null, unique]
  role         varchar(15)  [not null, note: 'admin | dean_office | teacher | student']
  employee_id  int          [unique, ref: - employees.id]
  student_id   int          [unique, ref: - students.id]
  is_active    boolean      [not null, default: true]
  created_at   timestamptz  [not null, default: `now()`]
}

Table audit_log {
  id          bigint       [pk, increment]
  table_name  varchar(63)  [not null]
  record_id   bigint       [not null]
  operation   varchar(11)  [not null, note: 'INSERT | UPDATE | DELETE | SOFT_DELETE | RESTORE']
  old_data    jsonb
  new_data    jsonb
  changed_by  int          [ref: > app_users.id]
  changed_at  timestamptz  [not null, default: `now()`]
}

// ───────────────────────── Organisation ─────────────────────────

Table faculties {
  id          int          [pk, increment]
  code        varchar(10)  [not null, unique, note: 'e.g. FCS']
  name        varchar(200) [not null, unique]
  dean_id     int          [ref: > employees.id, note: 'nullable: faculty may have no dean yet']
  ~audit_fields
  ~soft_delete
}

Table departments {
  id          int          [pk, increment]
  faculty_id  int          [not null, ref: > faculties.id]
  code        varchar(10)  [not null, unique]
  name        varchar(200) [not null]
  head_id     int          [ref: > employees.id]
  phone       varchar(20)
  ~audit_fields
  ~soft_delete
}

Table positions {
  id           smallint     [pk, increment]
  name         varchar(100) [not null, unique, note: 'assistant, senior lecturer, docent, professor, ...']
  is_academic  boolean      [not null, default: true]
}

Table employees {
  id             int          [pk, increment]
  department_id  int          [not null, ref: > departments.id]
  position_id    smallint     [not null, ref: > positions.id]
  first_name     varchar(50)  [not null]
  last_name      varchar(50)  [not null]
  middle_name    varchar(50)
  email          varchar(100) [not null, unique]
  phone          varchar(20)
  academic_degree varchar(30) [note: 'PhD, DSc, ... (nullable)']
  hire_date      date         [not null]
  salary         numeric(10,2) [not null, note: 'CHECK salary > 0']
  ~audit_fields
  ~soft_delete
}

// ───────────────────────── Students ─────────────────────────

Table degree_levels {
  id              smallint     [pk, increment]
  code            varchar(10)  [not null, unique, note: 'BSc | MSc | PhD']
  name            varchar(50)  [not null]
  duration_years  numeric(2,1) [not null]
}

Table specialties {
  id             int          [pk, increment]
  department_id  int          [not null, ref: > departments.id, note: 'graduating department']
  degree_level_id smallint    [not null, ref: > degree_levels.id]
  code           varchar(10)  [not null, note: 'state code, e.g. 121']
  name           varchar(200) [not null]

  indexes {
    (code, degree_level_id) [unique]
  }
}

Table student_groups {
  id               int          [pk, increment]
  specialty_id     int          [not null, ref: > specialties.id]
  code             varchar(20)  [not null, unique, note: 'e.g. КН-21']
  enrollment_year  smallint     [not null]
  curator_id       int          [ref: > employees.id]
  ~audit_fields
  ~soft_delete
}

Table students {
  id               int          [pk, increment]
  group_id         int          [not null, ref: > student_groups.id]
  record_book_no   varchar(20)  [not null, unique, note: 'natural key (alternate key)']
  first_name       varchar(50)  [not null]
  last_name        varchar(50)  [not null]
  middle_name      varchar(50)
  birth_date       date         [not null]
  email            varchar(100) [not null, unique]
  enrollment_date  date         [not null]
  funding_type     varchar(10)  [not null, note: 'budget | contract']
  status           varchar(20)  [not null, default: 'active', note: 'active | academic_leave | expelled | graduated']
  ~audit_fields
  ~soft_delete
}

// ───────────────────────── Teaching ─────────────────────────

Table courses {
  id             int          [pk, increment]
  department_id  int          [not null, ref: > departments.id]
  code           varchar(20)  [not null, unique]
  name           varchar(200) [not null]
  description    text
  ects_credits   numeric(4,1) [not null]
  hours_total    smallint     [not null]
  ~audit_fields
  ~soft_delete
}

Table course_prerequisites {
  course_id        int  [not null, ref: > courses.id]
  prerequisite_id  int  [not null, ref: > courses.id, note: 'CHECK prerequisite_id <> course_id']

  indexes {
    (course_id, prerequisite_id) [pk]
  }
}

Table academic_terms {
  id             int          [pk, increment]
  academic_year  varchar(9)   [not null, note: '2025/2026']
  semester       smallint     [not null, note: '1 | 2']
  start_date     date         [not null]
  end_date       date         [not null]

  indexes {
    (academic_year, semester) [unique]
  }
}

Table course_offerings {
  id           int  [pk, increment]
  course_id    int  [not null, ref: > courses.id]
  term_id      int  [not null, ref: > academic_terms.id]
  group_id     int  [not null, ref: > student_groups.id]
  lecturer_id  int  [not null, ref: > employees.id]
  ~audit_fields

  indexes {
    (course_id, term_id, group_id) [unique]
  }
}

Table enrollments {
  id            int          [pk, increment]
  student_id    int          [not null, ref: > students.id]
  offering_id   int          [not null, ref: > course_offerings.id]
  enrolled_at   timestamptz  [not null, default: `now()`]
  status        varchar(15)  [not null, default: 'enrolled', note: 'enrolled | completed | failed | withdrawn']
  final_points  numeric(5,2)
  ~audit_fields

  indexes {
    (student_id, offering_id) [unique]
  }
}

Table assessments {
  id               int          [pk, increment]
  offering_id      int          [not null, ref: > course_offerings.id]
  title            varchar(100) [not null]
  assessment_type  varchar(15)  [not null, note: 'module | exam | lab | test | coursework']
  max_points       numeric(5,2) [not null]
  due_date         date
  ~audit_fields
}

Table grades {
  id             int          [pk, increment]
  assessment_id  int          [not null, ref: > assessments.id]
  student_id     int          [not null, ref: > students.id]
  points         numeric(5,2) [not null]
  graded_by      int          [not null, ref: > employees.id]
  graded_at      timestamptz  [not null, default: `now()`]
  ~audit_fields

  indexes {
    (assessment_id, student_id) [unique]
  }
}

// ───────────────────────── Campus & schedule ─────────────────────────

Table buildings {
  id       smallint     [pk, increment]
  code     varchar(10)  [not null, unique]
  name     varchar(100) [not null]
  address  varchar(200) [not null]
}

Table classrooms {
  id           int          [pk, increment]
  building_id  smallint     [not null, ref: > buildings.id]
  room_number  varchar(10)  [not null]
  capacity     smallint     [not null]
  room_type    varchar(15)  [not null, note: 'lecture | seminar | lab | computer']

  indexes {
    (building_id, room_number) [unique]
  }
}

Table schedule_slots {
  id            int          [pk, increment]
  offering_id   int          [not null, ref: > course_offerings.id]
  classroom_id  int          [not null, ref: > classrooms.id]
  day_of_week   smallint     [not null, note: '1 (Mon) .. 6 (Sat)']
  pair_number   smallint     [not null, note: '1 .. 8']
  lesson_type   varchar(10)  [not null, note: 'lecture | practice | lab']
  week_parity   varchar(4)   [not null, default: 'all', note: 'all | odd | even']
}

Table attendance {
  id           bigint       [pk, increment]
  slot_id      int          [not null, ref: > schedule_slots.id]
  student_id   int          [not null, ref: > students.id]
  lesson_date  date         [not null]
  status       varchar(10)  [not null, note: 'present | absent | late | excused']

  indexes {
    (slot_id, student_id, lesson_date) [unique]
  }
}

// ───────────────────────── Finance ─────────────────────────

Table tuition_payments {
  id              int           [pk, increment]
  student_id      int           [not null, ref: > students.id]
  term_id         int           [not null, ref: > academic_terms.id]
  amount          numeric(10,2) [not null]
  paid_at         timestamptz   [not null, default: `now()`]
  payment_method  varchar(10)   [not null, note: 'card | bank | cash']
  reference       varchar(50)   [unique, note: 'bank transaction id']
  ~audit_fields
}
